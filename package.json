{
  "name": "garage-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A household car-maintenance app you run yourself (your own Cloudflare account, or Docker / Unraid), set up and researched with your own Claude.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "secrets": "node scripts/secrets.mjs",
    "set-password": "node scripts/secrets.mjs --password",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "node scripts/configure.mjs && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "dev": "wrangler dev",
    "demo": "node scripts/configure.mjs --local --mock-ai && wrangler d1 migrations apply DB --local && node scripts/secrets.mjs --local && node scripts/seed-demo.mjs && wrangler dev",
    "backup": "node scripts/backup.mjs",
    "test": "node --test --test-timeout=120000 test/*.test.mjs && python3 -m unittest research-worker/test_worker.py",
    "test:js": "node --test --test-timeout=120000 test/*.test.mjs",
    "test:e2e": "node scripts/e2e-local.mjs",
    "docker:bundle": "wrangler deploy --dry-run --outdir dist/worker --config wrangler.docker.jsonc",
    "docker:start": "node docker/server.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "imapflow": "2.12.2",
    "miniflare": "5.20261123.1-beta",
    "postal-mime": "^2.7.6",
    "undici": "7.30.2",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "wrangler": "^4.69.0"
  }
}

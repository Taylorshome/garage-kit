# Garage kit (Docker) settings. Copy to .env next to compose.yaml and fill in. Keep .env private: it holds secrets.
# Every *_PASSWORD / *_KEY / *_TOKEN / *_SECRET below can instead be read from a file: NAME_FILE=/run/secrets/name
# Full list with explanations: docs/docker.md#settings

APP_NAME=Garage
TZ=America/Chicago

# Public HTTPS address (Cloudflare Tunnel, Tailscale Funnel or a reverse proxy). Needed for Claude connectors (MCP)
# and iPhone notifications. Leave empty for LAN-only use.
PUBLIC_URL=
# Set to 1 only when a reverse proxy / tunnel is in front (it then trusts X-Forwarded-Proto/Host/For).
TRUST_PROXY=0

# Sign-in: password (default), oidc, cloudflare-access, or none (anyone who can reach it can change everything)
AUTH_MODE=password
GARAGE_PASSWORD=
# or a hash instead of the password: docker exec -it garage-kit garage hash-password
# PASSWORD_HASH=

# AI: none (default), openai-compatible (Ollama, LM Studio, OpenAI, OpenRouter...), anthropic, cloudflare-rest
AI_PROVIDER=none
# openai-compatible, e.g. Ollama on the same Unraid box:
# AI_BASE_URL=http://192.168.1.10:11434/v1
# AI_CHAT_MODEL=qwen3:14b
# AI_FAST_MODEL=qwen3:8b
# AI_VISION_MODEL=qwen2.5vl:7b
# AI_API_KEY=
# anthropic:
# ANTHROPIC_API_KEY=
# cloudflare-rest (Workers AI on your own Cloudflare account, free daily allowance):
# CF_ACCOUNT_ID=
# CF_API_TOKEN=

# Email-in by IMAP (receipts and scan reports), off unless IMAP_HOST is set:
# IMAP_HOST=imap.gmail.com
# IMAP_USER=garage.receipts@gmail.com
# IMAP_PASS=
# IMAP_FOLDER=INBOX

# Home Assistant notifications (HA_URL may be a LAN address):
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# HA_NOTIFY_TARGETS=mobile_app_my_phone

# Cloudflare Tunnel sidecar (docker/compose.cloudflared.yaml):
# TUNNEL_TOKEN=

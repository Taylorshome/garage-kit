{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "likely_causes", "check_order", "safe_to_drive", "parts", "videos", "sources", "questions_for_owner"],
  "properties": {
    "summary": { "type": "string", "description": "Plain English, 3-5 sentences" },
    "likely_causes": { "type": "array", "maxItems": 10, "items": { "type": "object", "additionalProperties": false,
      "required": ["cause", "likelihood", "why", "how_to_check", "fix", "diy_difficulty", "cost_diy", "cost_shop"],
      "properties": { "cause": { "type": "string" }, "likelihood": { "type": "string", "enum": ["high", "med", "low"] }, "why": { "type": "string" },
        "how_to_check": { "type": "string" }, "fix": { "type": "string" }, "diy_difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "cost_diy": { "type": "string" }, "cost_shop": { "type": "string" } } } },
    "check_order": { "type": "array", "maxItems": 15, "items": { "type": "string" }, "description": "Steps, cheapest first" },
    "safe_to_drive": { "type": "object", "additionalProperties": false, "required": ["verdict", "why"],
      "properties": { "verdict": { "type": "string", "enum": ["yes", "caution", "no"] }, "why": { "type": "string" } } },
    "parts": { "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["name", "part_numbers", "approx_price", "link"],
      "properties": { "name": { "type": "string" }, "part_numbers": { "type": "string" }, "approx_price": { "type": "string" }, "link": { "type": "string" } } } },
    "videos": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["title", "channel", "url"],
      "properties": { "title": { "type": "string" }, "channel": { "type": "string" }, "url": { "type": "string" } } } },
    "sources": { "type": "array", "minItems": 1, "maxItems": 25, "items": { "type": "object", "additionalProperties": false, "required": ["title", "url"],
      "properties": { "title": { "type": "string" }, "url": { "type": "string" } } } },
    "questions_for_owner": { "type": "array", "maxItems": 10, "items": { "type": "string" } }
  }
}
